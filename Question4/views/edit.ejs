<!DOCTYPE html>
<html>
<head>
    <title>Edit Employee</title>
</head>
<body>

    <h1>Edit Employee</h1>

    <form action="/employees/edit/<%= employee._id %>" method="POST">

        <label>Employee ID:</label>
        <input type="text" value="<%= employee.empid %>" disabled>

        <br><br>

        <label>Name:</label>
        <input type="text" name="name" value="<%= employee.name %>" required>

        <br><br>

        <label>Email:</label>
        <input type="email" name="email" value="<%= employee.email %>" required>

        <br><br>

        <label>Basic Salary:</label>
        <input type="number" name="basicSalary" value="<%= employee.basicSalary %>" min="0" required>

        <br><br>

        <button type="submit">Update Employee</button>

    </form>

    <br>

    <a href="/employees">Back to Employees</a>

</body>
</html>